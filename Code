module APB(PCLK,PRESETN,PSEL,PENABLE,PADDR,PWDATA,PRDATA,PWRITE,PREADY);

	input PCLK,PRESETN,PSEL,PENABLE,PWRITE;
	input [7:0] PADDR;
	input [7:0] PWDATA;
	output PREADY;
	output reg [7:0] PRDATA;

	parameter IDLE = 2'b00;
	parameter SETUP = 2'b01;
	parameter ACCESS = 2'b10;
	
	reg [7:0] mem[255:0];
	reg [1:0] current_state, next_state;

	assign PREADY=(PSEL&&PENABLE);

	always @(posedge PCLK or negedge PRESETN)
	begin
		if(!PRESETN)
		begin
			current_state<=IDLE;
			PRDATA<=0;
		end
		else
		begin
			current_state<=next_state;
		end

	end
		
	always @(*)
		begin
			case(current_state)
			IDLE :
			begin       
				if(PSEL==1)
				next_state=SETUP;
				
				else
				next_state = IDLE;
			end
			SETUP : 
			begin
				if(PENABLE==1 && PSEL==1)
				next_state = ACCESS;
								
				else
				next_state = SETUP;
			end
			ACCESS : 
			begin
				if(PSEL && PENABLE)
				begin 
					if(PWRITE==0)
						PRDATA<=mem[PADDR];
					else
						mem[PADDR]<=PWDATA;
				end
				        
			end

				default:
				next_state=IDLE;
		endcase
	end

endmodule
